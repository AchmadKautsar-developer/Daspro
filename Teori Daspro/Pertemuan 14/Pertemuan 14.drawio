      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% main()\n    subgraph MAIN[\&quot;main()\&quot;]\n        M1([Start]) --&gt; M2[\&quot;menu = {&#39;Kopi&#39;,&#39;Teh&#39;,&#39;Es Kelapa Muda&#39;,&#39;Roti Bakar&#39;,&#39;Gorengan&#39;}&lt;br/&gt;data[5][7], total[5], rata[5]\&quot;]\n        M2 --&gt; M3[\&quot;/Input pilihan: isi manual atau pakai data tabel/\&quot;]\n        M3 --&gt; M4[\&quot;data = inputPenjualan(data)\&quot;]\n        M4 --&gt; M5[\&quot;tampilPenjualan(menu, data)\&quot;]\n        M5 --&gt; M6[\&quot;total = hitungTotal(data)\&quot;]\n        M6 --&gt; M7[\&quot;idxTerlaris = cariTerlaris(total)\&quot;]\n        M7 --&gt; M8[\&quot;rata = hitungRataRata(total, 7)\&quot;]\n        M8 --&gt; M9[\&quot;/Tampilkan total per menu, menu terlaris &amp; rata-rata/\&quot;]\n        M9 --&gt; M10([End])\n    end\n\n    %% inputPenjualan\n    subgraph INP[\&quot;inputPenjualan(int[][] data)\&quot;]\n        I1([\&quot;inputPenjualan(data)\&quot;]) --&gt; I2[\&quot;i = 0\&quot;]\n        I2 --&gt; I3{\&quot;i &lt; 5?\&quot;}\n        I3 -- Ya --&gt; I4[\&quot;j = 0\&quot;]\n        I4 --&gt; I5{\&quot;j &lt; 7?\&quot;}\n        I5 -- Ya --&gt; I6[\&quot;/Input data[i][j]/\&quot;]\n        I6 --&gt; I7[\&quot;j++\&quot;] --&gt; I5\n        I5 -- Tidak --&gt; I8[\&quot;i++\&quot;] --&gt; I3\n        I3 -- Tidak --&gt; I9([\&quot;return data\&quot;])\n    end\n\n    %% tampilPenjualan\n    subgraph TMP[\&quot;tampilPenjualan(String[] menu, int[][] data)\&quot;]\n        T1([\&quot;tampilPenjualan(menu, data)\&quot;]) --&gt; T2[\&quot;i = 0\&quot;]\n        T2 --&gt; T3{\&quot;i &lt; 5?\&quot;}\n        T3 -- Ya --&gt; T4[\&quot;/Tampilkan menu[i] &amp; seluruh data[i][0..6]/\&quot;]\n        T4 --&gt; T5[\&quot;i++\&quot;] --&gt; T3\n        T3 -- Tidak --&gt; T6([End])\n    end\n\n    %% hitungTotal\n    subgraph TOT[\&quot;hitungTotal(int[][] data)\&quot;]\n        H1([\&quot;hitungTotal(data)\&quot;]) --&gt; H2[\&quot;int[] total = new int[5], i = 0\&quot;]\n        H2 --&gt; H3{\&quot;i &lt; 5?\&quot;}\n        H3 -- Ya --&gt; H4[\&quot;sum = 0, j = 0\&quot;]\n        H4 --&gt; H5{\&quot;j &lt; 7?\&quot;}\n        H5 -- Ya --&gt; H6[\&quot;sum += data[i][j]; j++\&quot;] --&gt; H5\n        H5 -- Tidak --&gt; H7[\&quot;total[i] = sum; i++\&quot;] --&gt; H3\n        H3 -- Tidak --&gt; H8([\&quot;return total\&quot;])\n    end\n\n    %% cariTerlaris &amp; hitungRataRata\n    subgraph ANL[\&quot;cariTerlaris(int[] total) &amp; hitungRataRata(int[] total, int hari)\&quot;]\n        A1([\&quot;cariTerlaris(total)\&quot;]) --&gt; A2[\&quot;maxIdx = 0; i = 1..4:&lt;br/&gt;jika total[i] &gt; total[maxIdx] -&gt; maxIdx = i\&quot;]\n        A2 --&gt; A3([\&quot;return maxIdx\&quot;])\n        R1([\&quot;hitungRataRata(total, hari)\&quot;]) --&gt; R2[\&quot;double[] rata = new double[5]&lt;br/&gt;i = 0..4: rata[i] = (double) total[i] / hari\&quot;]\n        R2 --&gt; R3([\&quot;return rata\&quot;])\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="d9AK_dyVF2Pj-x26lt-B-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
