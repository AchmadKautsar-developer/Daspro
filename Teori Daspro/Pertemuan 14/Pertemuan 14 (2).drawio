        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% main()\n    subgraph MAIN2[\&quot;main()\&quot;]\n        A1([Start]) --&gt; A2[\&quot;nama[5], nilai[5][3], nilaiAkhir[5], status[5]\&quot;]\n        A2 --&gt; A3[\&quot;bacaData(nama, nilai)\&quot;]\n        A3 --&gt; A4[\&quot;nilaiAkhir = hitungNilaiAkhir(nilai)\&quot;]\n        A4 --&gt; A5[\&quot;status = tentukanStatus(nilaiAkhir)\&quot;]\n        A5 --&gt; A6[\&quot;idxTertinggi = cariTertinggi(nilaiAkhir)\&quot;]\n        A6 --&gt; A7[\&quot;tampilHasil(nama, nilaiAkhir, status, idxTertinggi)\&quot;]\n        A7 --&gt; A8([End])\n    end\n\n    %% bacaData &amp; hitungNilaiAkhir\n    subgraph F12[\&quot;bacaData() &amp; hitungNilaiAkhir()\&quot;]\n        B1([\&quot;bacaData(nama, nilai)\&quot;]) --&gt; B2[\&quot;i = 0..4: /Input nama[i]/ &amp;&lt;br/&gt;j = 0..2: /Input nilai[i][j] (Tugas, Kuis, Praktikum)/\&quot;]\n        B2 --&gt; B3([End])\n\n        C1([\&quot;hitungNilaiAkhir(nilai)\&quot;]) --&gt; C2[\&quot;double[] akhir = new double[5]&lt;br/&gt;i = 0..4: akhir[i] = 0.3*nilai[i][0] + 0.3*nilai[i][1] + 0.4*nilai[i][2]\&quot;]\n        C2 --&gt; C3([\&quot;return akhir\&quot;])\n    end\n\n    %% tentukanStatus, cariTertinggi &amp; tampilHasil\n    subgraph F345[\&quot;tentukanStatus(), cariTertinggi() &amp; tampilHasil()\&quot;]\n        D1([\&quot;tentukanStatus(nilaiAkhir)\&quot;]) --&gt; D2[\&quot;i = 0..4:&lt;br/&gt;nilaiAkhir[i] &gt;= 70 ? &#39;LULUS&#39; : &#39;TIDAK LULUS&#39;\&quot;]\n        D2 --&gt; D3([\&quot;return status\&quot;])\n\n        E1([\&quot;cariTertinggi(nilaiAkhir)\&quot;]) --&gt; E2[\&quot;maxIdx = 0; i = 1..4:&lt;br/&gt;jika nilaiAkhir[i] &gt; nilaiAkhir[maxIdx] -&gt; maxIdx = i\&quot;]\n        E2 --&gt; E3([\&quot;return maxIdx\&quot;])\n\n        G1([\&quot;tampilHasil(nama, akhir, status, maxIdx)\&quot;]) --&gt; G2[\&quot;/Tampilkan tabel nama, nilai akhir, status &amp; juara tertinggi/\&quot;]\n        G2 --&gt; G3([End])\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="cuSnbLm0ZPQBqYNefCk5-1">
