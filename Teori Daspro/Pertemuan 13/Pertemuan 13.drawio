        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    A([Mulai]) --&gt; B[Inisialisasi array 2D survei[10][6]]\n    B --&gt; C[Inisialisasi Scanner &amp; variabel totalKeseluruhan = 0]\n    \n    %% Bagian A: Menyimpan Hasil Survei\n    C --&gt; D{Loop i dari 0 sampai 9 (Responden)}\n    D -- Ya --&gt; E{Loop j dari 0 sampai 5 (Pertanyaan)}\n    E -- Ya --&gt; F[/Input nilai survei[i][j]/]\n    F --&gt; E\n    E -- Selesai (j &gt;= 6) --&gt; D\n    D -- Selesai (i &gt;= 10) --&gt; G[Tampilkan Header Rata-rata Responden]\n    \n    %% Bagian B: Rata-rata Responden\n    G --&gt; H{Loop i dari 0 sampai 9}\n    H -- Ya --&gt; I[totalResponden = 0]\n    I --&gt; J{Loop j dari 0 sampai 5}\n    J -- Ya --&gt; K[totalResponden += survei[i][j] &lt;br/&gt; totalKeseluruhan += survei[i][j]]\n    K --&gt; J\n    J -- Selesai --&gt; L[rataResponden = totalResponden / 6]\n    L --&gt; M[/Tampilkan rataResponden/]\n    M --&gt; H\n    H -- Selesai --&gt; N[Tampilkan Header Rata-rata Pertanyaan]\n    \n    %% Bagian C: Rata-rata Pertanyaan\n    N --&gt; O{Loop j dari 0 sampai 5 (Pertanyaan)}\n    O -- Ya --&gt; P[totalPertanyaan = 0]\n    P --&gt; Q{Loop i dari 0 sampai 9 (Responden)}\n    Q -- Ya --&gt; R[totalPertanyaan += survei[i][j]]\n    R --&gt; Q\n    Q -- Selesai --&gt; S[rataPertanyaan = totalPertanyaan / 10]\n    S --&gt; T[/Tampilkan rataPertanyaan/]\n    T --&gt; O\n    O -- Selesai --&gt; U[Hitung rataKeseluruhan = totalKeseluruhan / 60]\n    \n    %% Bagian D: Rata-rata Keseluruhan\n    U --&gt; V[/Tampilkan rataKeseluruhan/]\n    V --&gt; W([Selesai])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="BjGUTZJjStZcAGur8Q4L-1">
